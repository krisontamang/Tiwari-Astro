# OpenRouter AI API (https://openrouter.ai)
# Supports multiple models: openai/gpt-4o-mini, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-haiku
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Astro Tiwari

# Astrologer API (https://github.com/g-battaglia/Astrologer-API.git)
# Subscribe on RapidAPI: https://rapidapi.com/kerykeion/api/astrologer
ASTROLOGER_RAPIDAPI_KEY=
ASTROLOGER_RAPIDAPI_HOST=astrologer.p.rapidapi.com

# Optional: Custom or Self-Hosted Astrologer-API / Kerykeion instance (e.g. running uvicorn app.main:app)
# ASTROLOGER_API_URL=http://localhost:8000
# KERYKEION_API_URL=http://localhost:8000

# Admin Credentials
ADMIN_EMAIL=bensartiwari@gmail.com
ADMIN_PASSWORD=Astro@369
ADMIN_TOKEN=astro-tiwari-secure-token-369-bensar

# RoxyAPI Vedic Astrology & Collections (https://github.com/RoxyAPI/postman-collections.git)
# Optional: Live Cloud API key from https://roxyapi.com (if omitted, high-precision local Vedic engine is used)
ROXY_API_KEY=
ROXY_API_URL=https://roxyapi.com/api/v2

# AstroWay Official TypeScript SDK (https://github.com/astroway/astroway-typescript.git)
# Optional: 10,000 free monthly credits from https://api.astroway.info/dashboard/sign-up
ASTROWAY_API_KEY=
ASTROWAY_BASE_URL=https://api.astroway.info/v1

# Asterwise Astrology API (https://github.com/asterwise/nextjs-vedic-matchmaking.git)
# Optional: 500 free calls/month from https://asterwise.com/dashboard
ASTERWISE_API_KEY=

# Vedika Astrology API (https://github.com/vedika-io/vedika-sdk-javascript.git)
# Optional: B2B API Key from https://vedika.io
VEDIKA_API_KEY=

# VedAstro Official Vedic Astrology Engine (https://github.com/VedAstro/VedAstro.git)
# Public API: https://api.vedastro.org/api (Free tier: FreeAPIUser)
VEDASTRO_API_KEY=FreeAPIUser
VEDASTRO_AYANAMSA=LAHIRI

# Server Port
PORT=3000
